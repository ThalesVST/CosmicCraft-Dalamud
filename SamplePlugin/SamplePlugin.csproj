<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.9.42.0</Version>
    <IconUrl>https://raw.githubusercontent.com/ThalesVST/CosmicCraft-Dalamud/main/images/icon.png</IconUrl>
    <Author>CosmicCraft</Author>
    <Name>CosmicCraft</Name>
    <Punchline>Assistente de crafting para Cosmic Exploration.</Punchline>
    <Description>Assistente de crafting com informações do artesão, planejamento de rotações e foco em qualidade e eficiência durante Cosmic Exploration.</Description>
    <Tags>crafting;cosmic;exploration</Tags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bundle a separately supplied, license-verified Raphael CLI binary when present. -->
    <None Include="raphael-cli.exe" Condition="Exists('raphael-cli.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>


